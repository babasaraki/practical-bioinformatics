#box(image("part8/15-practical-bioinformatics-project_files/figure-typst/fig-15-lengths-1.png", width: 90.0%))
], caption: figure.caption(
position: bottom, 
[
Length distributions of coding sequences in the RefSeq annotation and in the Prodigal prediction made under genetic code 11. The prediction is shifted towards short sequences and contains a large excess below 400 bp, which is the signature of genes broken into pieces rather than of genuine small genes.
]), 
kind: "quarto-float-fig", 
supplement: "Figure", 
