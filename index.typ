#> [Text(0, 0.5, 'Identity (%)'), Text(0.5, 1.0, '(a) Percentage identity')]
ax_columns.set(ylabel="Aligned columns", title="(b) Alignment length")
#> [Text(0, 0.5, 'Aligned columns'), Text(0.5, 1.0, '(b) Alignment length')]
