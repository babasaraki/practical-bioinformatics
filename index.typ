#strong[\9.] Track the line number with `enumerate` and write to `sys.stderr` when a sequence line arrives with no header in scope. The failure this catches is a truncated or concatenated download --- a file whose first record header was lost, so that the first few hundred bases belong to a sequence with no identifier. Silently discarding them produces a FASTA file that is one record short, with no error anywhere.

#block[
```
def read_fasta_strict(path):
    """Yield (header, sequence) pairs, warning about orphaned sequence lines."""
    header, chunks = None, []
    with open(path) as handle:
        for number, line in enumerate(handle, start=1):
            line = line.rstrip("\n")
            if line.startswith(">"):
                if header is not None:
                    yield header, "".join(chunks)
                header, chunks = line[1:], []
            elif line and header is None:
                print(f"line {number}: sequence before any header, ignored",
                      file=sys.stderr)
            else:
                chunks.append(line)
    if header is not None:
        yield header, "".join(chunks)

print(sum(1 for _ in read_fasta_strict(book_data("proteins", "p53-orthologs.fasta"))), "records")
#> 8 records
```

]
